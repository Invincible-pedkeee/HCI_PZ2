<UserControl x:Class="NetworkService.Views.MeasurementGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="White"
          Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENTITY SELECTION -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,18">

            <TextBlock Text="Prikaži istoriju mjerenja za put:"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

            <ComboBox Width="340"
                      Height="30"
                      ItemsSource="{Binding Entities}"
                      SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      ToolTip="Izaberi put za prikaz poslednjih mjerenja"/>
        </StackPanel>

        <!-- G1 MEASUREMENT GRAPH -->
        <Border Grid.Row="1"
                BorderBrush="#C8C8C8"
                BorderThickness="1"
                Padding="12"
                Margin="0,0,0,18">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="POSLEDNJIH 5 MJERENJA ZA IZABRANI PUT"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Canvas x:Name="MeasurementCanvas"
                        Grid.Row="1"
                        Background="#FAFAFA"
                        SizeChanged="MeasurementCanvas_SizeChanged"/>
            </Grid>
        </Border>

        <!-- CG4 TYPE DISTRIBUTION -->
        <Border Grid.Row="2"
                BorderBrush="#C8C8C8"
                BorderThickness="1"
                Padding="12"
                Margin="0,0,0,18">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="PROCENTUALNA ZASTUPLJENOST TIPOVA PUTEVA"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Canvas x:Name="DistributionCanvas"
                        Grid.Row="1"
                        Background="#FAFAFA"
                        SizeChanged="DistributionCanvas_SizeChanged"/>

                <TextBlock Grid.Row="2"
                           Text="{Binding DistributionText}"
                           FontSize="11"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <!-- LEGEND -->
        <Border Grid.Row="3"
                Background="#E8EDF3"
                CornerRadius="4"
                Padding="14">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Ellipse Width="18"
                         Height="18"
                         Stroke="Black"
                         Fill="White"
                         Margin="0,0,8,0"/>

                <TextBlock Text="Validno mjerenje"
                           VerticalAlignment="Center"
                           Margin="0,0,32,0"/>

                <Ellipse Width="18"
                         Height="18"
                         Stroke="Black"
                         Fill="#FFB3B3"
                         Margin="0,0,8,0"/>

                <TextBlock Text="Prekoračenje dozvoljene vrijednosti"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>