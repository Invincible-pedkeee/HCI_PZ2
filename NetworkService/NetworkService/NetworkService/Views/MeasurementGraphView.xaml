<UserControl x:Class="NetworkService.Views.MeasurementGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#FFFFFF"
          Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENTITY SELECTION -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,18"
                Effect="{StaticResource SoftShadow}">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Prikaži istoriju mjerenja za put:"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <ComboBox Width="340"
                          Height="32"
                          ItemsSource="{Binding Entities}"
                          SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          ToolTip="Izaberi put za prikaz poslednjih mjerenja"/>
            </StackPanel>
        </Border>

        <!-- G1 MEASUREMENT GRAPH -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,18"
                Effect="{StaticResource SoftShadow}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="POSLEDNJIH 5 MJERENJA ZA IZABRANI PUT"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,10"/>

                <Border Grid.Row="1"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <Canvas x:Name="MeasurementCanvas"
                            Background="#FBFCFE"
                            SizeChanged="MeasurementCanvas_SizeChanged"/>
                </Border>
            </Grid>
        </Border>

        <!-- CG4 TYPE DISTRIBUTION -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,18"
                Effect="{StaticResource SoftShadow}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="PROCENTUALNA ZASTUPLJENOST TIPOVA PUTEVA"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="1"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <Canvas x:Name="DistributionCanvas"
                            Background="#FBFCFE"
                            SizeChanged="DistributionCanvas_SizeChanged"/>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="{Binding DistributionText}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- LEGEND -->
        <Border Grid.Row="3"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Ellipse Width="18"
                         Height="18"
                         Stroke="Black"
                         StrokeThickness="1.5"
                         Fill="White"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"/>

                <TextBlock Text="Validno mjerenje"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,36,0"/>

                <Ellipse Width="18"
                         Height="18"
                         Stroke="#D64545"
                         StrokeThickness="1.5"
                         Fill="#FFB3B3"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"/>

                <TextBlock Text="Prekoračenje dozvoljene vrijednosti"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>