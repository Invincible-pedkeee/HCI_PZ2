<UserControl x:Class="NetworkService.Views.MeasurementGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#FFFFFF"
          Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,18"
                Effect="{StaticResource SoftShadow}">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Prikaži istoriju mjerenja za put:"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <ComboBox Width="340"
                          Height="32"
                          ItemsSource="{Binding Entities}"
                          SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          ToolTip="Izaberi put za prikaz poslednjih mjerenja"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,18"
                Effect="{StaticResource SoftShadow}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="POSLEDNJIH 5 MJERENJA ZA IZABRANI PUT"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,10"/>

                <Border Grid.Row="1"
                        CornerRadius="6"
                        ClipToBounds="True">

                    <Viewbox Stretch="Fill">
                        <Canvas Width="{Binding MeasurementCanvasWidth}"
                                Height="{Binding MeasurementCanvasHeight}"
                                Background="#FBFCFE">
 
                            <TextBlock Text="Nema mjerenja za izabrani entitet."
                                       Width="320"
                                       FontSize="13"
                                       Foreground="Gray"
                                       TextAlignment="Center"
                                       Visibility="{Binding HasNoMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Canvas.Left="290"
                                       Canvas.Top="130"/>
 
                            <Line X1="60"
                                  Y1="35"
                                  X2="860"
                                  Y2="35"
                                  Stroke="#E5EAF3"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"
                                  Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Line X1="60"
                                  Y1="84"
                                  X2="860"
                                  Y2="84"
                                  Stroke="#E5EAF3"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"
                                  Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Line X1="60"
                                  Y1="134"
                                  X2="860"
                                  Y2="134"
                                  Stroke="#E5EAF3"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"
                                  Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Line X1="60"
                                  Y1="183"
                                  X2="860"
                                  Y2="183"
                                  Stroke="#E5EAF3"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"
                                  Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Line X1="60"
                                  Y1="232"
                                  X2="860"
                                  Y2="232"
                                  Stroke="#E5EAF3"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"
                                  Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        
                            <Line X1="60"
                                  Y1="35"
                                  X2="60"
                                  Y2="232"
                                  Stroke="#64748B"
                                  StrokeThickness="1.2"
                                  Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                          
                            <Line X1="60"
                                  Y1="232"
                                  X2="860"
                                  Y2="232"
                                  Stroke="#64748B"
                                  StrokeThickness="1.2"
                                  Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Text="Vrijednost"
                                       FontSize="11"
                                       Foreground="#1F2937"
                                       Canvas.Left="12"
                                       Canvas.Top="8"
                                       Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Text="Vrijeme"
                                       FontSize="11"
                                       Foreground="#1F2937"
                                       Canvas.Left="820"
                                       Canvas.Top="256"
                                       Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                          
                            <ItemsControl ItemsSource="{Binding MeasurementLines}"
                                          Width="{Binding MeasurementCanvasWidth}"
                                          Height="{Binding MeasurementCanvasHeight}"
                                          Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Line X1="{Binding X1}"
                                              Y1="{Binding Y1}"
                                              X2="{Binding X2}"
                                              Y2="{Binding Y2}"
                                              Stroke="#2563EB"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                           
                            <ItemsControl ItemsSource="{Binding MeasurementMarkers}"
                                          Width="{Binding MeasurementCanvasWidth}"
                                          Height="{Binding MeasurementCanvasHeight}"
                                          Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Size}"
                                              Height="{Binding Size}">

                                            <Ellipse StrokeThickness="2">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Stroke" Value="#1F2937"/>
                                                        <Setter Property="Fill" Value="#F8FAFC"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                                <Setter Property="Fill" Value="#FECACA"/>
                                                                <Setter Property="Stroke" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <TextBlock Text="{Binding ValueText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                        
                                            <TextBlock Text="!"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#111827"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Bottom"
                                                       Margin="1,10,1,5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                           
                            <ItemsControl ItemsSource="{Binding MeasurementLabels}"
                                          Width="{Binding MeasurementCanvasWidth}"
                                          Height="{Binding MeasurementCanvasHeight}"
                                          Visibility="{Binding HasMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   Width="70"
                                                   FontSize="10"
                                                   Foreground="#1F2937"
                                                   TextAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>
        </Border>

         
        <Border Grid.Row="2"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,18"
                Effect="{StaticResource SoftShadow}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="PROCENTUALNA ZASTUPLJENOST TIPOVA PUTEVA"
                           Style="{StaticResource SectionHeader}"
                           Margin="1,1,1,8"/>

                <Border Grid.Row="1"
                        Height="34"
                        CornerRadius="5"
                        ClipToBounds="True"
                        Background="#EEF2F7"
                        VerticalAlignment="Center">

                    <Viewbox Stretch="Fill">
                        <Canvas Width="{Binding DistributionCanvasWidth}"
                                Height="34"
                                Background="#EEF2F7">

                            <ItemsControl ItemsSource="{Binding DistributionSegments}"
                                          Width="{Binding DistributionCanvasWidth}"
                                          Height="34">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Width}"
                                              Height="34"
                                              ClipToBounds="True">

                                            <Rectangle>
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Fill" Value="#7FA7D9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TypeName}" Value="IB">
                                                                <Setter Property="Fill" Value="#E7B36A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>

                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Viewbox>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="{Binding DistributionText}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </Grid>
        </Border>

    
        <Border Grid.Row="3"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Ellipse Width="18"
                         Height="18"
                         Stroke="#1F2937"
                         StrokeThickness="2"
                         Fill="#F8FAFC"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"/>

                <TextBlock Text="Validno mjerenje"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,36,0"/>

                <Ellipse Width="18"
                         Height="18"
                         Stroke="#DC2626"
                         StrokeThickness="2"
                         Fill="#FECACA"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"/>

                <TextBlock Text="Prekoračenje dozvoljene vrijednosti"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>