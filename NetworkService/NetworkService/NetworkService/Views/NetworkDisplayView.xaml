<UserControl x:Class="NetworkService.Views.NetworkDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:NetworkService.Model">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="255"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT TREEVIEW -->
        <Border Grid.Column="0"
                Background="#F2F2F2"
                BorderBrush="#C8C8C8"
                BorderThickness="0,0,1,0"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="DOSTUPNI ENTITETI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TreeView x:Name="EntitiesTreeView"
                          Grid.Row="1"
                          ItemsSource="{Binding AvailableEntityGroups}"
                          SelectedItemChanged="EntitiesTreeView_SelectedItemChanged"
                          MouseLeftButtonUp="EntitiesTreeView_MouseLeftButtonUp"
                          ToolTip="Drag road entities from this tree to the display grid">

                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type model:EntitiesByType}"
                                                  ItemsSource="{Binding Entities}">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding TypeName}"/>
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type model:NetworkEntity}">
                            <StackPanel Orientation="Vertical"
                                        Margin="0,4,0,4">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Name}"/>
                                <TextBlock FontSize="11"
                                           Foreground="Gray">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} | ID: {1}">
                                            <Binding Path="Type.Name"/>
                                            <Binding Path="Id"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Grid>
        </Border>

        <!-- CENTER DISPLAY GRID -->
        <Grid Grid.Column="1"
              Margin="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="PRIKAZ MREŽE"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding DisplaySlots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="3"
                                     Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6"
                                Padding="10"
                                BorderBrush="#A8A8A8"
                                BorderThickness="1"
                                AllowDrop="True"
                                DragOver="DisplaySlot_DragOver"
                                Drop="DisplaySlot_Drop">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                            <Setter Property="Background" Value="#EEF5FF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsValueInvalid}" Value="True">
                                            <Setter Property="Background" Value="#FFE3E3"/>
                                            <Setter Property="BorderBrush" Value="#AA0000"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding TitleText}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>

                                <StackPanel Grid.Row="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DetailsText}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="12"/>

                                    <TextBlock Text="{Binding StatusText}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="12"
                                               Margin="0,8,0,0"/>
                                </StackPanel>

                                <Button Grid.Row="2"
                                        Content="Ukloni"
                                        Height="24"
                                        Margin="0,8,0,0"
                                        Click="RemoveSlotButton_Click"
                                        Cursor="Hand"
                                        ToolTip="Remove entity from this display slot"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- RIGHT HISTORY PANEL -->
        <Border Grid.Column="2"
                Background="#F2F2F2"
                BorderBrush="#C8C8C8"
                BorderThickness="1,0,0,0"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="ISTORIJA IZVRŠENIH AKCIJA"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding HistoryActions}"
                         FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>