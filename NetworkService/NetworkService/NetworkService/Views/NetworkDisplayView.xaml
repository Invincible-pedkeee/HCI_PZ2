<UserControl x:Class="NetworkService.Views.NetworkDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:NetworkService.Model">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="255"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT TREEVIEW -->
        <Border Grid.Column="0"
                Background="#F2F2F2"
                BorderBrush="#C8C8C8"
                BorderThickness="0,0,1,0"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="DOSTUPNI ENTITETI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TreeView x:Name="EntitiesTreeView"
                          Grid.Row="1"
                          ItemsSource="{Binding AvailableEntityGroups}"
                          SelectedItemChanged="EntitiesTreeView_SelectedItemChanged"
                          MouseLeftButtonUp="EntitiesTreeView_MouseLeftButtonUp"
                          ToolTip="Drag road entities from this tree to the display grid">

                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type model:EntitiesByType}"
                                                  ItemsSource="{Binding Entities}">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding TypeName}"/>
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type model:NetworkEntity}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4,0,4">

                                <Image Source="{Binding Type.ImagePath}"
                                       Width="30"
                                       Height="30"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>

                                <StackPanel Orientation="Vertical">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Name}"/>

                                    <TextBlock FontSize="11"
                                               Foreground="Gray">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} | ID: {1}">
                                                <Binding Path="Type.Name"/>
                                                <Binding Path="Id"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Grid>
        </Border>

        <!-- CENTER DISPLAY GRID -->
        <Grid Grid.Column="1"
              Margin="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="PRIKAZ MREŽE"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>

                <TextBlock Text="{Binding ConnectionInfoText}"
                           FontSize="11"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>
            </StackPanel>

            <Grid Grid.Row="1">

                <ItemsControl x:Name="DisplaySlotsItemsControl"
                              ItemsSource="{Binding DisplaySlots}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="3"
                                         Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6"
                                    Padding="10"
                                    BorderBrush="#A8A8A8"
                                    BorderThickness="1"
                                    AllowDrop="True"
                                    MouseLeftButtonDown="DisplaySlot_MouseLeftButtonDown"
                                    DragOver="DisplaySlot_DragOver"
                                    Drop="DisplaySlot_Drop">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FAFAFA"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                <Setter Property="Background" Value="#EEF5FF"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsValueInvalid}" Value="True">
                                                <Setter Property="Background" Value="#FFE3E3"/>
                                                <Setter Property="BorderBrush" Value="#AA0000"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding TitleText}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Grid.Row="1"
                                                VerticalAlignment="Center">

                                        <Image Source="{Binding OccupiedEntity.Type.ImagePath}"
                                               Width="46"
                                               Height="46"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <TextBlock Text="{Binding DetailsText}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   FontSize="12"/>

                                        <TextBlock Text="{Binding StatusText}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   FontSize="12"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,8,0,0">

                                        <Button Content="Poveži"
                                                Width="65"
                                                Height="24"
                                                Click="ConnectSlotButton_Click"
                                                Cursor="Hand"
                                                ToolTip="Create connection with another occupied slot"/>

                                        <Button Content="Ukloni"
                                                Width="65"
                                                Height="24"
                                                Margin="6,0,0,0"
                                                Click="RemoveSlotButton_Click"
                                                Cursor="Hand"
                                                ToolTip="Remove entity from this display slot"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Canvas for drawing connection lines over display slots -->
                <Canvas x:Name="ConnectionsCanvas"
                        IsHitTestVisible="False"
                        Panel.ZIndex="10"/>
            </Grid>
        </Grid>

        <!-- RIGHT HISTORY PANEL -->
        <Border Grid.Column="2"
                Background="#F2F2F2"
                BorderBrush="#C8C8C8"
                BorderThickness="1,0,0,0"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="ISTORIJA IZVRŠENIH AKCIJA"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding HistoryActions}"
                         FontSize="11"/>

                <StackPanel Grid.Row="2"
                            Margin="0,12,0,0">

                    <Button Content="Poništi poslednju akciju"
                            Height="28"
                            Command="{Binding UndoCommand}"
                            Cursor="Hand"
                            ToolTip="Undo last action on Network Display View"/>

                    <Button Content="Poništi sve akcije"
                            Height="28"
                            Margin="0,8,0,0"
                            Command="{Binding UndoAllCommand}"
                            Cursor="Hand"
                            ToolTip="Undo all actions on Network Display View"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>