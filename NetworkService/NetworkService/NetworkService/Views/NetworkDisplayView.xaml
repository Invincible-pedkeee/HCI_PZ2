<UserControl x:Class="NetworkService.Views.NetworkDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:NetworkService.Model"
             xmlns:controls="clr-namespace:NetworkService.Controls"
             xmlns:networkDisplayHelpers="clr-namespace:NetworkService.Helpers.NetworkDisplay">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT TREEVIEW -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="18">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="DOSTUPNI ENTITETI"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,12"/>

                <Border Grid.Row="1"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        Effect="{StaticResource SoftShadow}">

                    <TreeView x:Name="EntitiesTreeView"
                              ItemsSource="{Binding AvailableEntityGroups}"
                              networkDisplayHelpers:NetworkDisplayDragDropBehavior.EnableTreeViewEntityDrag="True"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTip="Drag road entities from this tree to the display grid">

                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type model:EntitiesByType}"
                                                      ItemsSource="{Binding Entities}">
                                <TextBlock FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding TypeName}"/>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type model:NetworkEntity}">
                                <Border Background="Transparent"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="0,2">
                                    <StackPanel Orientation="Horizontal">

                                        <Image Source="{Binding Type.ImagePath}"
                                               Width="30"
                                               Height="30"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>

                                        <StackPanel Orientation="Vertical"
                                                    VerticalAlignment="Center">

                                            <TextBlock FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Text="{Binding Name}"/>

                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} | ID: {1}">
                                                        <Binding Path="Type.Name"/>
                                                        <Binding Path="Id"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Border>
            </Grid>
        </Border>

        <!-- CENTER DISPLAY GRID -->
        <Grid Grid.Column="1"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,14">

                <TextBlock Text="PRIKAZ MREŽE"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,4"/>

                <TextBlock Text="{Binding ConnectionInfoText}"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <Grid Grid.Row="1">

                <ItemsControl x:Name="DisplaySlotsItemsControl"
                              ItemsSource="{Binding DisplaySlots}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="3"
                                         Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="7"
                                    CornerRadius="10"
                                    BorderBrush="#D4DAE3"
                                    BorderThickness="1">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FBFCFE"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                <Setter Property="Background" Value="#EAF1FF"/>
                                                <Setter Property="BorderBrush" Value="#B9CDF2"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsValueInvalid}" Value="True">
                                                <Setter Property="Background" Value="#FCE9E9"/>
                                                <Setter Property="BorderBrush" Value="#D64545"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Canvas AllowDrop="True"
                                        Background="Transparent"
                                        ClipToBounds="True"
                                        networkDisplayHelpers:NetworkDisplayDragDropBehavior.EnableSlotDragDrop="True">

                                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                          Margin="8">

                                        <!-- EMPTY SLOT -->
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="{Binding TitleText}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextBrush}"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Text="Prevuci entitet ovdje"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,10,0,0"/>

                                            <TextBlock Text="Status: slobodno polje"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- OCCUPIED SLOT -->
                                        <Grid Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0"
                                                  Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SlotNumber, StringFormat='Canvas {0}'}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <Border Grid.Column="1"
                                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="2">

                                                    <Image Source="{Binding OccupiedEntity.Type.ImagePath}"
                                                           Width="50"
                                                           Height="50"
                                                           Margin="0,0,20,0"/>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1"
                                                        VerticalAlignment="Center">

                                                <TextBlock FontSize="14"
                                                           Foreground="{StaticResource TextBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}ID: {0} - {1}">
                                                            <Binding Path="OccupiedEntity.Id"/>
                                                            <Binding Path="OccupiedEntity.Name"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>

                                                <TextBlock FontSize="16"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Text="{Binding OccupiedEntity.Type.Name, StringFormat='Tip: {0}'}"/>

                                                <TextBlock FontSize="16"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Text="{Binding OccupiedEntity.LastValue, StringFormat='Vrednost: {0}'}"/>

                                                <TextBlock FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding OccupiedEntity.Status, StringFormat='Status: {0}'}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,30,0,0">

                                                <Button Content="Poveži"
                                                        Style="{StaticResource SlotButton}"
                                                        Width="70"
                                                        Height="24"
                                                        Command="{Binding DataContext.ConnectSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        ToolTip="Kreiranje veze sa drugim entitetom"/>

                                                <Button Content="Ukloni"
                                                        Style="{StaticResource SlotButtonDanger}"
                                                        Width="80"
                                                        Height="24"
                                                        Margin="6,30,30,30"
                                                        Command="{Binding DataContext.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        ToolTip="Ukloni entitet sa mreže"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Canvas>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:ConnectionLinesCanvas DisplaySlotsItemsControl="{Binding ElementName=DisplaySlotsItemsControl}"
                                                 DisplaySlots="{Binding DisplaySlots}"
                                                 Connections="{Binding Connections}"
                                                 IsHitTestVisible="False"
                                                 Panel.ZIndex="10"/>
            </Grid>
        </Grid>

        <!-- RIGHT HISTORY PANEL -->
        <Border Grid.Column="2"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1,0,0,0"
                Padding="18">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="ISTORIJA IZVRŠENIH AKCIJA"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,12"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding HistoryActions}"
                         FontSize="11">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2"
                            Margin="0,14,0,0">

                    <Button Content="Poništi poslednju akciju"
                            Height="32"
                            Command="{Binding UndoCommand}"
                            Cursor="Hand"
                            ToolTip="Undo last action on Network Display View"/>

                    <Button Content="Poništi sve akcije"
                            Height="32"
                            Margin="0,8,0,0"
                            Command="{Binding UndoAllCommand}"
                            Cursor="Hand"
                            ToolTip="Undo all actions on Network Display View"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>