<UserControl x:Class="NetworkService.Views.NetworkEntitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ButtonIcon" TargetType="{x:Type fa5:SvgAwesome}">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <Style x:Key="ButtonContentText" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="18,18,18,18">
                <StackPanel>

                    <TextBlock Text="DODAVANJE NOVOG ENTITETA"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,12"/>

                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Effect="{StaticResource SoftShadow}">
                        <StackPanel>

                            <TextBlock Text="ID puta"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>

                            <TextBox Height="32"
                                     Padding="6,0"
                                     Text="{Binding CurrentEntityInput.IdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Unesite jedinstveni ID puta (cijeli broj)"/>

                            <TextBlock Text="{Binding CurrentEntityInput.ValidationErrors[IdText]}"
                                       Style="{StaticResource ValidationText}"
                                       Margin="0,3,0,8"/>

                            <TextBlock Text="Naziv puta"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>

                            <TextBox Height="32"
                                     Padding="6,0"
                                     Text="{Binding CurrentEntityInput.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Unesite naziv puta (npr. Autoput E75)"/>

                            <TextBlock Text="{Binding CurrentEntityInput.ValidationErrors[Name]}"
                                       Style="{StaticResource ValidationText}"
                                       Margin="0,3,0,8"/>

                            <TextBlock Text="Tip puta"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>

                            <ComboBox Height="32"
                                      ItemsSource="{Binding EntityTypes}"
                                      SelectedItem="{Binding CurrentEntityInput.SelectedType, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      ToolTip="Izaberite tip puta: IA ili IB"/>

                            <TextBlock Text="{Binding CurrentEntityInput.ValidationErrors[SelectedType]}"
                                       Style="{StaticResource ValidationText}"
                                       Margin="0,3,0,12"/>

                            <Button Style="{StaticResource PrimaryButton}"
                                    Height="34"
                                    Command="{Binding AddEntityCommand}"
                                    Cursor="Hand"
                                    ToolTip="Dodaj novi put u sistem za monitoring">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <fa5:SvgAwesome Icon="Solid_PlusCircle"
                                                    Style="{StaticResource ButtonIcon}"/>
                                    <TextBlock Text="DODAJ U SISTEM"
                                               Style="{StaticResource ButtonContentText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="PRETRAGA I FILTER"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,24,0,12"/>

                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Effect="{StaticResource SoftShadow}">
                        <StackPanel>
                            <TextBlock Text="Tip puta"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>

                            <ComboBox Height="32"
                                      ItemsSource="{Binding EntityTypes}"
                                      SelectedItem="{Binding SelectedFilterType, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      ToolTip="Filtriraj po tipu puta: IA ili IB"/>

                            <TextBlock Text="Poređenje po ID vrijednosti"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,12,0,4"/>

                            <ListBox ItemsSource="{Binding IdComparisonOptions}"
                                     SelectedItem="{Binding SelectedIdComparison, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="0,0,0,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <RadioButton Content="{Binding}"
                                                                 IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"
                                                                 GroupName="IdComparison"
                                                                 Margin="0,0,14,0"
                                                                 VerticalContentAlignment="Center"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <TextBlock Text="{Binding FilterComparisonError}"
                                       Style="{StaticResource ValidationText}"
                                       Margin="0,3,0,6"/>

                            <TextBlock Text="ID vrijednost za filter"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>

                            <TextBox Height="32"
                                     Padding="6,0"
                                     Text="{Binding FilterIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Unesite ID vrijednost za filtriranje"/>

                            <TextBlock Text="{Binding FilterIdError}"
                                       Style="{StaticResource ValidationText}"
                                       Margin="0,3,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="32"
                                        Command="{Binding ApplyFilterCommand}"
                                        Cursor="Hand"
                                        ToolTip="Primijeni izabrane filtere na tabelu">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <fa5:SvgAwesome Icon="Solid_Filter"
                                                        Style="{StaticResource ButtonIcon}"/>
                                        <TextBlock Text="Primijeni"
                                                   Style="{StaticResource ButtonContentText}"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Height="32"
                                        Command="{Binding ClearFilterCommand}"
                                        Cursor="Hand"
                                        ToolTip="Poništi sve filtere i prikaži sve entitete">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <fa5:SvgAwesome Icon="Solid_Times"
                                                        Style="{StaticResource ButtonIcon}"/>
                                        <TextBlock Text="Poništi"
                                                   Style="{StaticResource ButtonContentText}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DODATNI FILTER STANJA"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,24,0,12"/>

                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Effect="{StaticResource SoftShadow}">

                        <ListBox ItemsSource="{Binding StatusFilterOptions}"
                                 SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <RadioButton Content="{Binding}"
                                                             IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"
                                                             GroupName="StatusFilter"
                                                             Margin="0,0,0,6"
                                                             VerticalContentAlignment="Center"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ENTITETI MREŽE"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,12"/>

            <Border Grid.Row="1"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="1"
                    Effect="{StaticResource SoftShadow}">

                <DataGrid ItemsSource="{Binding FilteredEntities}"
                          SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="46"
                          MinRowHeight="46"
                          ColumnHeaderHeight="42"
                          FontSize="13"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5EAF3"
                          ToolTip="Tabela svih monitorisanih puteva u sistemu">

                    <DataGrid.Resources>
                        <Style x:Key="CenteredCellText" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>

                        <Style x:Key="NameCellText" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="12,0,4,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Background" Value="#F3F6FA"/>
                            <Setter Property="BorderBrush" Value="#DDE4EE"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="80"
                                            ElementStyle="{StaticResource CenteredCellText}"/>

                        <DataGridTemplateColumn Header="Slika"
                                                Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Type.ImagePath}"
                                           Width="38"
                                           Height="38"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Naziv"
                                            Binding="{Binding Name}"
                                            Width="1.6*"
                                            MinWidth="280"
                                            ElementStyle="{StaticResource NameCellText}"/>

                        <DataGridTextColumn Header="Tip"
                                            Binding="{Binding Type.Name}"
                                            Width="105"
                                            ElementStyle="{StaticResource CenteredCellText}"/>

                        <DataGridTextColumn Header="Poslednja vrednost"
                                            Binding="{Binding LastValue}"
                                            Width="1*"
                                            MinWidth="165"
                                            ElementStyle="{StaticResource CenteredCellText}"/>

                        <DataGridTemplateColumn Header="Status"
                                                Width="0.8*"
                                                MinWidth="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}"
                                               Style="{StaticResource StatusCellText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">

                <Button Style="{StaticResource DangerButton}"
                        Width="210"
                        Height="34"
                        Command="{Binding RequestDeleteEntityCommand}"
                        Cursor="Hand"
                        ToolTip="Obriši selektovani entitet iz sistema">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <fa5:SvgAwesome Icon="Solid_TrashAlt"
                                        Style="{StaticResource ButtonIcon}"/>
                        <TextBlock Text="OBRIŠI SELEKTOVANO"
                                   Style="{StaticResource ButtonContentText}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Column="2"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1,0,0,0"
                Padding="18">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="ISTORIJA IZVRŠENIH AKCIJA"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,12"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding HistoryActions}"
                         FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2"
                            Margin="0,14,0,0">

                    <Button Height="32"
                            Command="{Binding UndoCommand}"
                            Cursor="Hand"
                            ToolTip="Poništi poslednju izvršenu akciju (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <fa5:SvgAwesome Icon="Solid_Undo"
                                            Style="{StaticResource ButtonIcon}"/>
                            <TextBlock Text="Poništi poslednju akciju"
                                       Style="{StaticResource ButtonContentText}"/>
                        </StackPanel>
                    </Button>

                    <Button Height="32"
                            Margin="0,8,0,0"
                            Command="{Binding UndoAllCommand}"
                            Cursor="Hand"
                            ToolTip="Poništi sve do sad izvršene akcije (Ctrl+Shift+Z)">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <fa5:SvgAwesome Icon="Solid_History"
                                            Style="{StaticResource ButtonIcon}"/>
                            <TextBlock Text="Poništi sve akcije"
                                       Style="{StaticResource ButtonContentText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.ColumnSpan="3"
              Background="#80101826"
              Visibility="{Binding IsDeleteDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="440"
                    Background="White"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="26"
                    Effect="{StaticResource SoftShadow}">

                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,14">
                        <Border Width="34" Height="34"
                                CornerRadius="17"
                                Background="{StaticResource DangerSoftBgBrush}"
                                Margin="0,0,12,0">
                            <TextBlock Text="!"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="POTVRDA AKCIJE: UKLANJANJE ENTITETA"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Da li ste sigurni da želite trajno obrisati selektovani put? Ova akcija će kasnije ukloniti i sve povezane linije."
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,22"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Width="120"
                                Height="34"
                                Margin="0,0,12,0"
                                Command="{Binding CancelDeleteEntityCommand}"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <fa5:SvgAwesome Icon="Solid_Times"
                                                Style="{StaticResource ButtonIcon}"/>
                                <TextBlock Text="ODUSTANI"
                                           Style="{StaticResource ButtonContentText}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DangerButton}"
                                Width="155"
                                Height="34"
                                Command="{Binding ConfirmDeleteEntityCommand}"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <fa5:SvgAwesome Icon="Solid_Check"
                                                Style="{StaticResource ButtonIcon}"/>
                                <TextBlock Text="DA, POTVRĐUJEM"
                                           Style="{StaticResource ButtonContentText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>