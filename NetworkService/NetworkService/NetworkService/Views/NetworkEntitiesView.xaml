<UserControl x:Class="NetworkService.Views.NetworkEntitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="255"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0"
                Background="#F2F2F2"
                BorderBrush="#C8C8C8"
                BorderThickness="0,0,1,0"
                Padding="14">

            <StackPanel>
                <TextBlock Text="DODAVANJE NOVOG ENTITETA"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Separator Margin="0,0,0,10"/>

                <TextBox Height="28"
                         Text="{Binding CurrentEntityInput.IdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Enter unique road ID"/>

                <TextBlock Text="{Binding CurrentEntityInput.ValidationErrors[IdText]}"
                           Foreground="DarkRed"
                           FontSize="11"
                           Margin="0,3,0,10"/>

                <TextBox Height="28"
                         Text="{Binding CurrentEntityInput.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Enter road name"/>

                <TextBlock Text="{Binding CurrentEntityInput.ValidationErrors[Name]}"
                           Foreground="DarkRed"
                           FontSize="11"
                           Margin="0,3,0,10"/>

                <ComboBox Height="28"
                          ItemsSource="{Binding EntityTypes}"
                          SelectedItem="{Binding CurrentEntityInput.SelectedType, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          ToolTip="Select road type"/>

                <TextBlock Text="{Binding CurrentEntityInput.ValidationErrors[SelectedType]}"
                           Foreground="DarkRed"
                           FontSize="11"
                           Margin="0,3,0,12"/>

                <Button Content="[+] DODAJ U SISTEM"
                        Height="30"
                        Command="{Binding AddEntityCommand}"
                        Cursor="Hand"
                        ToolTip="Add new road entity"/>

                <Separator Margin="0,24,0,12"/>

                <TextBlock Text="FILTER ENTITETA"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Tip puta"
                           FontSize="11"
                           Margin="0,0,0,3"/>

                <ComboBox Height="28"
                          ItemsSource="{Binding EntityTypes}"
                          SelectedItem="{Binding SelectedFilterType, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          ToolTip="Filter roads by type IA or IB"/>

                <TextBlock Text="ID uslov"
                           FontSize="11"
                           Margin="0,10,0,3"/>      

                <ComboBox Height="28"
                          ItemsSource="{Binding IdComparisonOptions}"
                          SelectedItem="{Binding SelectedIdComparison, Mode=TwoWay}"
                          ToolTip="Select ID comparison operator"/>

                <TextBlock Text="{Binding FilterComparisonError}"
                           Foreground="DarkRed"
                           FontSize="11"
                           Margin="0,3,0,6"/>

                <TextBox Height="28"
                         Text="{Binding FilterIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Enter ID value for filtering"/>

                <TextBlock Text="{Binding FilterIdError}"
                           Foreground="DarkRed"
                           FontSize="11"
                           Margin="0,3,0,8"/>

                <TextBlock Text="Status poslednjeg mjerenja"
                           FontSize="11"
                           Margin="0,0,0,3"/>

                <ComboBox Height="28"
                          ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                          ToolTip="Filter by valid or invalid last measured value"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,14,0,0">

                    <Button Content="PRIMIJENI"
                            Width="105"
                            Height="28"
                            Command="{Binding ApplyFilterCommand}"
                            Cursor="Hand"
                            ToolTip="Apply selected filters"/>

                    <Button Content="RESET"
            Width="90"
            Height="28"
            Margin="8,0,0,0"
            Command="{Binding ClearFilterCommand}"
            Cursor="Hand"
            ToolTip="Clear all filters"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CENTER TABLE -->
        <Grid Grid.Column="1"
              Margin="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ENTITETI MREŽE"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredEntities}"
                      SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      ToolTip="Table of all monitored road entities">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Naziv"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Tip"
                                        Binding="{Binding Type.Name}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Poslednja vrednost"
                                        Binding="{Binding LastValue}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,12,0,0">

                <Button Content="UNDO"
            Width="90"
            Height="30"
            Command="{Binding UndoCommand}"
            Cursor="Hand"
            ToolTip="Undo last action on Network Entities View"/>

                <Button Content="UNDO ALL"
            Width="100"
            Height="30"
            Margin="8,0,0,0"
            Command="{Binding UndoAllCommand}"
            Cursor="Hand"
            ToolTip="Undo all actions on Network Entities View"/>

                <Button Content="[-] OBRIŠI SELEKTOVANO"
            Width="170"
            Height="30"
            Margin="8,0,0,0"
            Command="{Binding RequestDeleteEntityCommand}"
            Cursor="Hand"
            ToolTip="Delete selected road entity"/>
            </StackPanel>
        </Grid>

        <!-- RIGHT HISTORY PANEL -->
        <Border Grid.Column="2"
                Background="#F2F2F2"
                BorderBrush="#C8C8C8"
                BorderThickness="1,0,0,0"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="ISTORIJA IZVRŠENIH AKCIJA"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding HistoryActions}"
                         FontSize="11"/>
            </Grid>
        </Border>

        <!-- CUSTOM DELETE CONFIRMATION OVERLAY -->
        <Grid Grid.ColumnSpan="3"
              Background="#80000000"
              Visibility="{Binding IsDeleteDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="420"
                    Height="190"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="POTVRDA AKCIJE: UKLANJANJE ENTITETA"
                               FontWeight="SemiBold"
                               FontSize="13"/>

                    <TextBlock Grid.Row="1"
                               Text="Da li ste sigurni da želite trajno obrisati selektovani put? Ova akcija će kasnije ukloniti i sve povezane linije."
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Button Content="DA, POTVRĐUJEM"
                                Width="145"
                                Height="30"
                                Margin="0,0,30,0"
                                Command="{Binding ConfirmDeleteEntityCommand}"
                                Cursor="Hand"/>

                        <Button Content="ODUSTANI"
                                Width="120"
                                Height="30"
                                Command="{Binding CancelDeleteEntityCommand}"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>