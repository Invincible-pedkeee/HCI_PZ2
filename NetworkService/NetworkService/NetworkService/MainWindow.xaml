<Window x:Class="NetworkService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModel="clr-namespace:NetworkService.ViewModel"
        xmlns:views="clr-namespace:NetworkService.Views"
        Title="Network Service"
        Height="760"
        Width="1200"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewModel:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type viewModel:NetworkEntitiesViewModel}">
            <views:NetworkEntitiesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:NetworkDisplayViewModel}">
            <views:NetworkDisplayView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:MeasurementGraphViewModel}">
            <views:MeasurementGraphView/>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+1"
                Command="{Binding NavigationCommand}"
                CommandParameter="entities"/>

        <KeyBinding Gesture="Ctrl+2"
                Command="{Binding NavigationCommand}"
                CommandParameter="display"/>

        <KeyBinding Gesture="Ctrl+3"
                Command="{Binding NavigationCommand}"
                CommandParameter="graph"/>

        <KeyBinding Gesture="Ctrl+N"
                Command="{Binding GlobalAddCommand}"/>

        <KeyBinding Gesture="Delete"
                Command="{Binding GlobalDeleteCommand}"/>

        <KeyBinding Gesture="Ctrl+Z"
                Command="{Binding GlobalUndoCommand}"/>

        <KeyBinding Gesture="Ctrl+Shift+Z"
                Command="{Binding GlobalUndoAllCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Header / Navigation -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <Border Width="10" Height="10"
                            CornerRadius="5"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"/>
                    <TextBlock Text="Network Service"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#F4F6F9"
                        CornerRadius="9"
                        Padding="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">

                        <Button Content="Entiteti mreže"
                                Style="{StaticResource NavTabButton}"
                                Width="150"
                                Height="32"
                                Command="{Binding NavigationCommand}"
                                CommandParameter="entities"
                                ToolTip="Prikaži tabelarni prikaz entiteta (Ctrl+1)"/>

                        <Button Content="Prikaz mreže"
                                Style="{StaticResource NavTabButton}"
                                Width="150"
                                Height="32"
                                Margin="6,0,0,0"
                                Command="{Binding NavigationCommand}"
                                CommandParameter="display"
                                ToolTip="Prikaži drag and drop mrežu (Ctrl+2)"/>

                        <Button Content="Grafikon mjerenja"
                                Style="{StaticResource NavTabButton}"
                                Width="150"
                                Height="32"
                                Margin="6,0,0,0"
                                Command="{Binding NavigationCommand}"
                                CommandParameter="graph"
                                ToolTip="Prikaži grafikone mjerenja (Ctrl+3)"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Active View -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentViewModel}"/>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="#F4F6F9"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Border Width="8" Height="8"
                        CornerRadius="4"
                        Background="{StaticResource SuccessBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Toast notification -->
        <Border Grid.RowSpan="3"
                Width="350"
                MinHeight="86"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,48"
                CornerRadius="10"
                Background="{Binding ToastService.BackgroundColor}"
                BorderBrush="{Binding ToastService.BorderColor}"
                BorderThickness="1.5"
                Effect="{StaticResource SoftShadow}"
                Visibility="{Binding ToastService.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="1000">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- accent strip uses the toast's own border colour -->
                <Border Grid.Column="0"
                        Background="{Binding ToastService.BorderColor}"
                        CornerRadius="10,0,0,10"/>

                <StackPanel Grid.Column="1"
                            Margin="14,12,16,12">
                    <TextBlock Text="{Binding ToastService.Title}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,5"/>

                    <TextBlock Text="{Binding ToastService.Message}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
