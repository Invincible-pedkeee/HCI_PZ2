<Window x:Class="NetworkService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModel="clr-namespace:NetworkService.ViewModel"
        xmlns:views="clr-namespace:NetworkService.Views"
        Title="Network Service"
        Height="760"
        Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewModel:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type viewModel:NetworkEntitiesViewModel}">
            <views:NetworkEntitiesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:NetworkDisplayViewModel}">
            <views:NetworkDisplayView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:MeasurementGraphViewModel}">
            <views:MeasurementGraphView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Header / Navigation -->
        <Grid Grid.Row="0" Background="#E5E5E5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Network Service"
                       FontSize="20"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button Content="Entiteti mreže"
                        Width="150"
                        Height="28"
                        Command="{Binding NavigationCommand}"
                        CommandParameter="entities"
                        ToolTip="Prikaži tabelarni prikaz entiteta"/>

                <Button Content="Prikaz mreže"
                        Width="150"
                        Height="28"
                        Margin="4,0,0,0"
                        Command="{Binding NavigationCommand}"
                        CommandParameter="display"
                        ToolTip="Prikaži drag and drop mrežu"/>

                <Button Content="Grafikon mjerenja"
                        Width="150"
                        Height="28"
                        Margin="4,0,0,0"
                        Command="{Binding NavigationCommand}"
                        CommandParameter="graph"
                        ToolTip="Prikaži grafikone mjerenja"/>
            </StackPanel>
        </Grid>

        <!-- Active View -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentViewModel}"/>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="#E5E5E5"
                BorderBrush="#BFBFBF"
                BorderThickness="1,1,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </Border>

        <!-- Toast notification -->
        <Border Grid.RowSpan="3"
                Width="340"
                MinHeight="86"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,48"
                Padding="14"
                Background="{Binding ToastService.BackgroundColor}"
                BorderBrush="{Binding ToastService.BorderColor}"
                BorderThickness="2"
                Visibility="{Binding ToastService.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="1000">

            <StackPanel>
                <TextBlock Text="{Binding ToastService.Title}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,0,0,6"/>

                <TextBlock Text="{Binding ToastService.Message}"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>